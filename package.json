{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "A local project quality scanner.",
  "type": "module",
  "bin": {
    "sentinel": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/src/cli.js",
    "pretest": "npm run build",
    "test": "vitest run --dir tests",
    "pretest:watch": "npm run build",
    "test:watch": "vitest --dir tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ignore": "^7.0.6",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
