{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "A local project quality scanner.",
  "type": "module",
  "bin": {
    "sentinel": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
